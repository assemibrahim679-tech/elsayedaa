rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // الإحصائيات ظاهرة للزوار، لكن لا يمكن زيادة إلا عداد واحد بمقدار 1.
    match /stats/global {
      allow read: if true;

      // السماح بإنشاء المستند أول مرة بعداد واحد فقط.
      allow create: if
        (request.resource.data.keys().hasOnly(['visitors']) && request.resource.data.visitors == 1) ||
        (request.resource.data.keys().hasOnly(['tasbih1']) && request.resource.data.tasbih1 == 1) ||
        (request.resource.data.keys().hasOnly(['tasbih2']) && request.resource.data.tasbih2 == 1) ||
        (request.resource.data.keys().hasOnly(['tasbih3']) && request.resource.data.tasbih3 == 1) ||
        (request.resource.data.keys().hasOnly(['dua']) && request.resource.data.dua == 1);

      // الواجهة تستخدم FieldValue.increment(1)، لذلك نتحقق من المجال المتغير
      // ومن أن قيمته زادت بمقدار واحد فقط.
      allow update: if
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visitors']) &&
          request.resource.data.visitors == resource.data.visitors + 1) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tasbih1']) &&
          request.resource.data.tasbih1 == resource.data.tasbih1 + 1) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tasbih2']) &&
          request.resource.data.tasbih2 == resource.data.tasbih2 + 1) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tasbih3']) &&
          request.resource.data.tasbih3 == resource.data.tasbih3 + 1) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dua']) &&
          request.resource.data.dua == resource.data.dua + 1);

      allow delete: if false;
    }

    // رسائل نموذج "سيب رأيك": يمكن للزائر الإرسال فقط، وليس القراءة أو التعديل أو الحذف.
    match /feedback/{feedbackId} {
      allow create: if
        request.resource.data.keys().hasOnly(['name', 'message', 'createdAt', 'page']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() <= 100 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0 &&
        request.resource.data.message.size() <= 2000 &&
        request.resource.data.page is string &&
        request.resource.data.page.size() <= 500 &&
        request.resource.data.createdAt == request.time;

      allow read, update, delete: if false;
    }

    // أي مجموعة أخرى مغلقة افتراضيًا.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
